generator client {
  provider      = "prisma-client-js"
  output        = "../../../apps/web/src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  child
  parent
  both
}

enum Tone {
  light
  deep
}

enum SensitiveStatus {
  active
  paused_health
  deceased
  memorial
}

enum AnswerFormat {
  text
  photo
  video
  audio
}

enum BookStatus {
  draft
  generated
  delivered
}

enum BookEditionType {
  interim
  final
}

enum QuestionSource {
  ai
  curated
  followup
  custom
  parent_message
}

// 답변의 출처 — 자녀 질문에 대한 응답인지, 부모가 먼저 남긴 메시지인지
enum AnswerOrigin {
  question_response
  parent_initiated
}

// 서비스 문의 (마이페이지 FAQ 하단)
enum InquiryCategory {
  bug
  feature
  payment
  privacy
  etc
}

enum InquiryStatus {
  new
  in_progress
  resolved
}

// 회원가입 시 항목별 동의 기록 (PIPA: 항목별 동의여부 + 일시 + 약관 버전)
enum ConsentType {
  privacy_required // [필수] 서비스 이용을 위한 개인정보 수집·이용
  terms_required // [필수] 이용약관 동의
  age_over_14 // [필수] 만 14세 이상 확인 (만 14세 미만 법정대리인 동의는 TODO)
  analytics // [선택] 접속정보(IP 등) 수집
  marketing // [선택] 마케팅·알림 수신
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  phone            String?   @unique
  name             String
  role             Role
  avatarUrl        String?
  passwordHash     String?
  consentAnalytics Boolean   @default(false)
  consentMarketing Boolean   @default(false)
  consentAt        DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sentConnections     Connection[]       @relation("fromUser")
  receivedConnections Connection[]       @relation("toUser")
  childInvites        ConnectionInvite[] @relation("childConnectionInvites")
  acceptedInvites     ConnectionInvite[] @relation("acceptedConnectionInvites")
  sessions            Session[]
  reactions           Reaction[]
  accessLogs          AccessLog[]
  admin               Admin?
  consents            Consent[]
}

model Consent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  agreed    Boolean
  version   String      @default("v1.0") // 동의 시점의 약관/처리방침 버전
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([type])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Connection {
  id              String          @id @default(cuid())
  fromUserId      String
  fromUser        User            @relation("fromUser", fields: [fromUserId], references: [id])
  toUserId        String
  toUser          User            @relation("toUser", fields: [toUserId], references: [id])
  intimacy        Int             @default(3)
  cohabiting      Boolean         @default(false)
  hasConflict     Boolean         @default(false)
  responseChannel String          @default("app")
  tone            Tone            @default(light)
  sensitiveStatus SensitiveStatus @default(active)
  currentDepth    Int             @default(1)
  skipCount       Int             @default(0)
  answerCount     Int             @default(0)
  inviteCode      String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  questions    Question[]
  bookEditions BookEdition[]
  invite       ConnectionInvite?

  @@index([fromUserId])
  @@index([toUserId])
}

model ConnectionInvite {
  id              String      @id @default(cuid())
  code            String      @unique
  childId         String
  child           User        @relation("childConnectionInvites", fields: [childId], references: [id], onDelete: Cascade)
  acceptedById    String?
  acceptedBy      User?       @relation("acceptedConnectionInvites", fields: [acceptedById], references: [id], onDelete: SetNull)
  connectionId    String?     @unique
  connection      Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  tone            Tone        @default(light)
  intimacy        Int         @default(3)
  cohabiting      Boolean     @default(false)
  responseChannel String      @default("app")
  createdAt       DateTime    @default(now())
  acceptedAt      DateTime?
  expiresAt       DateTime?

  @@index([childId])
  @@index([acceptedById])
  @@index([createdAt])
}

model Question {
  id           String         @id @default(cuid())
  connectionId String
  connection   Connection     @relation(fields: [connectionId], references: [id])
  body         String
  depth        Int
  chapterTag   String?
  personTag    String?
  eraTag       String?
  source       QuestionSource @default(curated)
  sentAt       DateTime?
  createdAt    DateTime       @default(now())

  answer Answer?

  @@index([connectionId])
  @@index([sentAt])
}

model Answer {
  id          String       @id @default(cuid())
  questionId  String       @unique
  question    Question     @relation(fields: [questionId], references: [id])
  format      AnswerFormat @default(text)
  origin      AnswerOrigin @default(question_response) // 부모 자발 메시지 구분
  body        String?
  mediaUrl    String?
  transcript  String?
  skipped     Boolean      @default(false)
  receivedVia String       @default("app")
  isPrivate   Boolean      @default(false) // 부모가 비공개로 설정하면 자녀에게 내용이 보이지 않음
  keywords    String[]     @default([]) // 키워드 답변 시 입력한 키워드 (AI 합성 원본)
  aiComposed  Boolean      @default(false) // AI가 키워드로 합성한 답변 여부
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reactions Reaction[]
}

model Reaction {
  id         String   @id @default(cuid())
  answerId   String
  answer     Answer   @relation(fields: [answerId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  emoji      String?
  comment    String?
  isFollowup Boolean  @default(false)
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([answerId])
  @@index([userId])
}

model BookEdition {
  id           String          @id @default(cuid())
  connectionId String
  connection   Connection      @relation(fields: [connectionId], references: [id])
  rangeFrom    DateTime
  rangeTo      DateTime?
  status       BookStatus      @default(draft)
  editionType  BookEditionType @default(interim)
  chapterData  Json?
  pdfUrl       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([connectionId])
}

model CuratedQuestion {
  id         String  @id @default(cuid())
  body       String
  depth      Int
  chapterTag String
  personTag  String?
  eraTag     String?
  language   String  @default("ko")

  @@index([depth])
  @@index([chapterTag])
}

model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  name      String?
  ipAddress String?
  userAgent String?
  path      String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Admin {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Inquiry {
  id        String           @id @default(cuid())
  userId    String? // 로그인 사용자면 연결 (탈퇴 시 문의는 남기되 연결 해제)
  email     String // 회신용
  category  InquiryCategory?
  message   String
  status    InquiryStatus    @default(new)
  ipAddress String? // 분석 수집에 동의한 사용자만 (PIPA)
  userAgent String? // 동의한 사용자만
  emailSent Boolean          @default(false) // 관리자 알림 메일 발송 성공 여부
  createdAt DateTime         @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model AdminAudit {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetIds String[]
  createdAt DateTime @default(now())

  @@index([adminId])
}

// ── 방문자 전환율(퍼널) 추적 ──────────────────────────────────
// 익명 비식별 단계: anonymousId(우리가 발급한 무작위 쿠키), UTM, path, referrer, 대략적 기기,
// IP는 원문 대신 ipHash만 저장. 식별정보(이름·이메일·원문 IP)는 동의/로그인 후 AccessLog에만 둔다.

enum ConversionType {
  signup_started
  signup_completed
  first_login
  onboarding_completed
}

// 익명 방문자 집계 단위 (anonymousId). first-touch UTM은 덮어쓰지 않고, last-touch는 최신값 갱신.
model Visitor {
  anonymousId     String    @id
  firstSeen       DateTime  @default(now())
  lastSeen        DateTime  @default(now())
  visitCount      Int       @default(0)
  // first-touch (최초 유입 출처 — 한 번만 기록)
  ftSource        String?
  ftMedium        String?
  ftCampaign      String?
  ftContent       String?
  ftTerm          String?
  // last-touch (가장 최근 유입 출처 — 매번 갱신)
  ltSource        String?
  ltMedium        String?
  ltCampaign      String?
  ltContent       String?
  ltTerm          String?
  // 전환(가입/로그인 도달) — 다대일: 여러 anonymousId가 한 user로 연결될 수 있음
  convertedUserId String?
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())

  events      VisitorEvent[]
  conversions ConversionEvent[]

  @@index([convertedUserId])
  @@index([ftSource])
  @@index([firstSeen])
}

model VisitorEvent {
  id          String   @id @default(cuid())
  anonymousId String
  visitor     Visitor  @relation(fields: [anonymousId], references: [anonymousId], onDelete: Cascade)
  path        String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  gclid       String?
  deviceType  String? // 대략적 기기/브라우저 종류 (mobile/tablet/desktop · bot)
  ipHash      String? // 익명 단계: 해시만. 원문 IP는 저장하지 않음
  createdAt   DateTime @default(now())

  @@index([anonymousId])
  @@index([createdAt])
  @@index([utmSource])
}

model ConversionEvent {
  id          String         @id @default(cuid())
  anonymousId String?
  visitor     Visitor?       @relation(fields: [anonymousId], references: [anonymousId], onDelete: SetNull)
  userId      String?
  type        ConversionType
  createdAt   DateTime       @default(now())

  @@index([anonymousId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
