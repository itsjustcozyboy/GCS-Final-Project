# 데이터베이스 — Supabase 사용 시:
# DATABASE_URL  = Transaction mode pooler (포트 6543, ?pgbouncer=true&connection_limit=1)
# DIRECT_URL    = Direct connection (포트 5432, prisma migrate용)
# 로컬 PostgreSQL 사용 시 두 값을 동일하게 설정
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maeum_itgi"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/maeum_itgi"

# AI (서버 전용 — 절대 NEXT_PUBLIC_ 접두어 금지)
# 우선순위: Gemini → Anthropic → Mock. 모두 비우면 Mock으로 로컬 전체 플로우가 돈다.
# Gemini 2.5 Flash (Generative Language API). GOOGLE_AI_API_KEY 또는 GEMINI_API_KEY 둘 중 하나.
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
# Google 무료 티어는 분/일 요청 한도가 있음. 한도 초과(429) 시 사용자에게 안내 후 Mock 폴백.
ANTHROPIC_API_KEY=

# 채널 어댑터 (없으면 Mock 사용)
KAKAO_API_KEY=
KAKAO_SENDER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 스토리지 (없으면 로컬 디스크 사용)
STORAGE_PROVIDER=local
UPLOADS_DIR=./uploads
UPLOADS_URL=http://localhost:3000/uploads

# S3 (STORAGE_PROVIDER=s3일 때)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 앱
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 관리자로 자동 등록할 이메일 (쉼표 구분, 서버 전용). 이 목록의 이메일로 로그인하면
# Admin 테이블에 자동 등록된다(소스코드에 이메일을 박지 않고 환경변수로만 관리).
ADMIN_EMAILS=leokor5069@gmail.com,taei518@gmail.com
# 공용 관리자 비밀번호 — ADMIN_EMAILS의 이메일 + 이 비밀번호로 로그인하면 관리자 권한 부여.
# ⚠️ 보안: 절대 '123456' 같은 약한 값/평문을 운영에 쓰지 말 것. 운영 배포 전 반드시
# 길고 무작위한 강한 비밀번호로 변경하고, 첫 로그인 후에도 주기적으로 교체한다.
ADMIN_PASSWORD=__set-a-strong-random-password__
# 비밀번호 해싱 솔트 — 프로덕션에서는 반드시 랜덤 고유 값으로 변경
PASSWORD_SALT=maeum-dev-salt
NODE_ENV=development

# 문의 알림 메일 — Resend (키 없으면 콘솔 Mock 발송)
# 주의: Resend 발신 도메인 검증 전에는 onboarding@resend.dev로만 발송 가능하며
# 무료 티어는 일/월 발송량 제한이 있음. 운영 전 도메인 검증 필요.
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=leokor1214@gachon.ac.kr
INQUIRY_NOTIFY_FROM=onboarding@resend.dev
